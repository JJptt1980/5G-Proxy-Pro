<?xml version="1.0" encoding="utf-8"?>
<!-- debug 版才有 App 內更新（SelfUpdate.kt）；release／F-Droid 版不加這個權限。
     安裝時系統一定會跳出自己的確認畫面。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <receiver
            android:name="com.tokyoxpa3.androidproxy.SelfUpdateReceiver"
            android:exported="false" />

        <!-- 快速設定方塊「5G Pro」（ProTileService.kt）：點一下開關代理。 -->
        <service
            android:name="com.tokyoxpa3.androidproxy.ProTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_pro"
            android:label="5G Pro"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>

</manifest>
